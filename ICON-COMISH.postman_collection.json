          "name": "Size",
          "item": [
            {
              "name": "Get Size",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "// Visualization Script",
                      "",
                      "// Visualization Script",
                      "const template = `",
                      "<style>",
                      "  body { font-family: sans-serif; padding: 12px; }",
                      "  h3 { margin: 0 0 12px; font-size: 15px; color: #333; }",
                      "  table { width: 100%; border-collapse: collapse; font-size: 13px; }",
                      "  th { background: #f0f0f0; text-align: left; padding: 8px 10px; border-bottom: 2px solid #ddd; color: #555; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; }",
                      "  td { padding: 8px 10px; border-bottom: 1px solid #eee; color: #333; }",
                      "  tr:hover td { background: #fafafa; }",
                      "  .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; text-transform: uppercase; }",
                      "  .active { background: #d1fae5; color: #065f46; }",
                      "  .inactive { background: #fee2e2; color: #991b1b; }",
                      "</style>",
                      "<h3>Sizes ({{total}} records)</h3>",
                      "<table>",
                      "  <tr>",
                      "    <th>#</th>",
                      "    <th>Name</th>",
                      "    <th>Size</th>",
                      "    <th>Status</th>",
                      "    <th>Created By</th>",
                      "    <th>Updated By</th>",
                      "  </tr>",
                      "  {{#each rows}}",
                      "  <tr>",
                      "    <td>{{id}}</td>",
                      "    <td>{{name}}</td>",
                      "    <td>{{size}}</td>",
                      "    <td><span class=\"badge {{statusClass}}\">{{status}}</span></td>",
                      "    <td>{{createdBy}}</td>",
                      "    <td>{{updatedBy}}</td>",
                      "  </tr>",
                      "  {{/each}}",
                      "</table>`;",
                      "",
                      "function createPayload() {",
                      "  const body = pm.response.json();",
                      "  const items = body.data || [];",
                      "  return {",
                      "    total: items.length,",
                      "    rows: items.map(function(item) {",
                      "      return {",
                      "        id: item.id,",
                      "        name: item.name,",
                      "        size: item.size,",
                      "        status: item.status,",
                      "        statusClass: item.status === 'active' ? 'active' : 'inactive',",
                      "        createdBy: item.created_username,",
                      "        updatedBy: item.updated_username",
                      "      };",
                      "    })",
                      "  };",
                      "}",
                      "",
                      "pm.visualizer.set(template, createPayload());",
                      ""
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
